# OpenRouter API Key (Get one free at https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# AI Model to use for all 5 Multi-Agent pipelines
MODEL_NAME=nvidia/nemotron-3-nano-30b-a3b:free

# Server Host & Port (Configured by Cloud platform)
# HOST=0.0.0.0
# PORT=5000

# Optional: Frontend API Base URL (if deploying Frontend & Backend separately)
# VITE_API_BASE_URL=https://your-backend.onrender.com
