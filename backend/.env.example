# OpenRouter API Key (Get one free at https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# AI Model to use for all 5 Multi-Agent pipelines
MODEL_NAME=nvidia/nemotron-3-nano-30b-a3b:free

# Server Host & Port (Set automatically by Render/Cloud platforms)
# HOST=0.0.0.0
# PORT=5000

# Optional site URL for OpenRouter attribution
SITE_URL=https://your-app.onrender.com
